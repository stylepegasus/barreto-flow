**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage

# Debug logs, screenshots, and temporary files
*.log
npm-debug.log*
*.tmp
*.png
*.jpg
*.jpeg
*.webm
!public/**
.DS_Store
Thumbs.db
