# ==============================================================================
# Obrigatórias para produção (Cloud Run)
# ==============================================================================

# GEMINI_API_KEY: Chave da API Gemini utilizada pela Dona (/api/assistant/chat).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ZAPSIGN_API_TOKEN: Token de API do ZapSign para leitura server-side de contratos assinados.
ZAPSIGN_API_TOKEN="MY_ZAPSIGN_API_TOKEN"

# NODE_ENV: Define modo de execução ("production" no Cloud Run para servir dist/).
NODE_ENV="production"

# PORT: Porta HTTP injetada automaticamente pelo Cloud Run (fallback local: 3000).
PORT="8080"

# ==============================================================================
# Recomendadas / Opcionais (possuem fallback no código)
# ==============================================================================

# FIREBASE_PROJECT_ID: Projeto Firebase usado na verificação de tokens autenticados.
FIREBASE_PROJECT_ID="gen-lang-client-0925403191"

# APPS_SCRIPT_URL: Sobrescreve a URL oficial HTTPS (/macros/s/...) do Google Apps Script.
APPS_SCRIPT_URL=""

# APP_URL: URL pública do serviço hospedado no Cloud Run.
APP_URL="MY_APP_URL"
